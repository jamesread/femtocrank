{
  "name": "femtocrank",
  "description": "A simple CSS theme with high accessibility and zero dependencies.",
  "main": "style.css",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate --config html-validate.config.mjs \"index.html\" \"tests/**/*.html\"",
    "lint": "npm run lint:css && npm run lint:html && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesread/femtocrank.git"
  },
  "author": "",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/jamesread/femtocrank/issues"
  },
  "homepage": "https://github.com/jamesread/femtocrank#readme",
  "devDependencies": {
    "html-validate": "^11.0.0",
    "semantic-release": "^25.0.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
